diff --git a/Tests/Unit/RootViewTests.swift b/Tests/Unit/RootViewTests.swift
index 511df04..927e755 100644
--- a/Tests/Unit/RootViewTests.swift
+++ b/Tests/Unit/RootViewTests.swift
@@ -6,0 +7,47 @@ final class RootViewTests: XCTestCase {
+    @MainActor
+    func testT17DiagnoseStationaryInteractiveMovement() async throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("T17-diagnostic-\(UUID())")
+        let store = AccountStore(fileURL: root.appendingPathComponent("accounts.json"))
+        _ = try await store.setDemoMode(true)
+        for _ in 0..<3 { _ = try await store.addDemo(now: Date()) }
+        var accounts = try await store.load()
+        accounts[0].source = nil
+        accounts[0].quotaSnapshot = nil
+        accounts[0].quotaState = .notApplicable
+        accounts[0].subscription = .init(planType: "Free", observedAt: Date())
+        defer { try? FileManager.default.removeItem(at: root) }
+        let controller = UIHostingController(rootView: QuotaView(accounts: accounts, canReorder: true))
+        let scene = try XCTUnwrap(UIApplication.shared.connectedScenes.first as? UIWindowScene)
+        let window = UIWindow(windowScene: scene)
+        window.frame = CGRect(x: 0, y: 0, width: 414, height: 896)
+        window.rootViewController = controller
+        window.makeKeyAndVisible()
+        defer { window.isHidden = true; window.rootViewController = nil }
+        try await Task.sleep(for: .milliseconds(600))
+        func find(_ view: UIView) -> UICollectionView? {
+            if let collection = view as? UICollectionView { return collection }
+            return view.subviews.compactMap { find($0) }.first
+        }
+        let collection = try XCTUnwrap(find(controller.view))
+        let frames = (0..<3).compactMap {
+            collection.collectionViewLayout.layoutAttributesForItem(at: IndexPath(item: $0, section: 0))?.frame
+        }
+        print("T17_DIAG initial frames=\(frames) bounds=\(collection.bounds)")
+        XCTAssertEqual(frames.count, 3)
+        for fraction in [0.05, 0.25, 0.49, 0.51, 0.75, 0.95] {
+            QuotaDragDiagnostic.events = []
+            XCTAssertTrue(collection.beginInteractiveMovementForItem(at: IndexPath(item: 0, section: 0)))
+            let targetY = frames[1].minY + frames[1].height * fraction
+            QuotaDragDiagnostic.y = targetY
+            for tick in 0..<30 {
+                QuotaDragDiagnostic.y = targetY + (tick.isMultiple(of: 2) ? -0.5 : 0.5)
+                collection.updateInteractiveMovementTargetPosition(CGPoint(x: frames[0].midX, y: QuotaDragDiagnostic.y))
+                try await Task.sleep(for: .milliseconds(40))
+            }
+            let swaps = QuotaDragDiagnostic.events.filter { $0.0 != $0.1 }
+            print("T17_DIAG HOLD fraction=\(fraction) y=\(targetY) proposals=\(swaps)")
+            collection.cancelInteractiveMovement()
+            try await Task.sleep(for: .milliseconds(400))
+        }
+    }
+
